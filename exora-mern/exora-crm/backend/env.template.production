# ==============================================
# EXORA CRM BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================

# Node Environment (development | production)
NODE_ENV=production

# Server Configuration
PORT=8000

# CORS Origins (comma-separated, use * for all)
# Production: https://exora.solutions,https://crm.exora.solutions
# Development: http://localhost:3000,http://localhost:3001
CORS_ORIGINS=https://exora.solutions,https://crm.exora.solutions

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exora-crm
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Full Database URL (alternative to individual DB vars)
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/exora-crm

# JWT Configuration
# IMPORTANT: Use the SAME secret as your main Exora backend
JWT_SECRET=your_jwt_secret_from_main_exora_backend

# n8n Integration
N8N_API_KEY=your_n8n_api_key
N8N_BASE_URL=https://n8n.exora.solutions

# n8n Webhook Base URL (for Evolution API webhooks)
N8N_WEBHOOK_BASE_URL=https://n8n.exora.solutions/webhook

# Auto-sync automations from n8n on server startup (true | false)
# Set to true to sync all users' automation catalogs on backend restart
# Recommended: false (sync happens automatically on first login or activation)
AUTO_SYNC_AUTOMATIONS=false

# WhatsApp (Evolution API)
EVOLUTION_API_URL=https://evolution.exora.solutions
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_WEBHOOK_URL=https://crm-api.exora.solutions/api/webhooks/evolution
EVOLUTION_WEBHOOK_SECRET=your_webhook_secret_for_validation

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Google Calendar/Gmail (MCP Servers)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OpenAI API (for AI agents)
OPENAI_API_KEY=your_openai_api_key

# Ollama (local LLM - optional)
OLLAMA_BASE_URL=http://localhost:11434

# Frontend URLs
# Used for CORS and redirects
EXORA_FRONTEND_URL=https://exora.solutions
CRM_FRONTEND_URL=https://crm.exora.solutions

# ==============================================
# PRODUCTION DEPLOYMENT NOTES:
# ==============================================
# 1. Copy this file to .env and fill with actual credentials
# 2. Ensure JWT_SECRET matches main Exora backend
# 3. Use strong passwords and API keys
# 4. Configure proper CORS origins for security
# ==============================================

