        "jsCode": "// Transform configs array to object for easy lookup\nconst configItems = $input.all();\nconst enabledModules = {};\n\nconfigItems.forEach(item => {\n  if (item.json.module_key && item.json.config_data) {\n    enabledModules[item.json.module_key] = item.json.config_data;\n  }\n});\n\n// Get original webhook data\nconst webhookData = $node[\"Validate Input\"].json;\n\nreturn [{\n  json: {\n    ...webhookData,\n    enabled_modules: enabledModules,\n    total_enabled: Object.keys(enabledModules).length\n  }\n}];"
      },
