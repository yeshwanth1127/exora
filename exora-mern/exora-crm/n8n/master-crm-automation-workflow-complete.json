    {
      "parameters": {
        "jsCode": "// Build conversation context for AI\nconst history = $input.all();\nconst whatsappData = $node[\"WhatsApp Handler\"].json;\nconst currentMessage = $node[\"Validate Input\"].json.message;\n\n// Format conversation history\nconst conversationContext = history.map(item => {\n  const direction = item.json.direction === 'inbound' ? 'Customer' : 'Assistant';\n  return `${direction}: ${item.json.body}`;\n}).reverse().join('\\n');\n\n// Get AI config from AI Agent module (if enabled)\nconst aiAgentConfig = whatsappData.enabled_modules?.ai_agent || {};\nconst systemPrompt = aiAgentConfig.system_prompt || 'You are a helpful customer service assistant.';\nconst temperature = aiAgentConfig.temperature || 0.7;\nconst maxTokens = aiAgentConfig.max_tokens || 500;\n\nreturn [{\n  json: {\n    ...whatsappData,\n    contact_id: $node[\"Find Contact\"].json.id || $node[\"Create Contact\"].json.id,\n    current_message: currentMessage,\n    conversation_history: conversationContext,\n    ai_config: {\n      system_prompt: systemPrompt,\n      temperature: temperature,\n      max_tokens: maxTokens,\n      model: whatsappData.ai_model\n    }\n  }\n}];"
      },
      "id": "prepare-ai-context",
      "name": "Prepare AI Context",
      "type": "n8n-nodes-base.code",
