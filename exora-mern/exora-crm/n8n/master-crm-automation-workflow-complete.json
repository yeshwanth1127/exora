      "parameters": {
        "jsCode": "// ========================================\n// MODULE 1: WHATSAPP HANDLER\n// ========================================\n\nconst data = $input.first().json;\nconst whatsappConfig = data.enabled_modules?.whatsapp;\n\n// Check if WhatsApp is enabled\nif (!whatsappConfig || Object.keys(whatsappConfig).length === 0) {\n  return [{\n    json: {\n      ...data,\n      module: 'whatsapp',\n      status: 'disabled',\n      error: 'WhatsApp module not enabled for this user',\n      skip_execution: true\n    }\n  }];\n}\n\n// WhatsApp IS enabled - prepare for processing\nreturn [{\n  json: {\n    ...data,\n    module: 'whatsapp',\n    status: 'processing',\n    config: whatsappConfig,\n    // Extract config values for easy access\n    instance_name: whatsappConfig.instance_name || 'default',\n    auto_reply: whatsappConfig.auto_reply !== false,\n    ai_model: whatsappConfig.ai_model || 'gpt-3.5'\n  }\n}];"
      },
