# ==============================================
# EXORA CRM FRONTEND - ENVIRONMENT CONFIGURATION
# ==============================================

# Backend API URL
# Production: https://crm-api.exora.solutions or https://exora.solutions/crm-api
# Development: http://localhost:8000/api
VITE_API_URL=https://crm-api.exora.solutions/api

# Main Exora Frontend URL (for auth redirects)
# Production: https://exora.solutions
# Development: http://localhost:3000
VITE_EXORA_URL=https://exora.solutions

# CRM Frontend URL (self-reference for webhooks/callbacks)
# Production: https://crm.exora.solutions
# Development: http://localhost:3001
VITE_CRM_URL=https://crm.exora.solutions

# Environment Mode
VITE_ENV=production

# ==============================================
# DEVELOPMENT CONFIGURATION:
# ==============================================
# For local development, create .env.local with:
#
# VITE_API_URL=http://localhost:8000/api
# VITE_EXORA_URL=http://localhost:3000
# VITE_CRM_URL=http://localhost:3001
# VITE_ENV=development
# ==============================================

