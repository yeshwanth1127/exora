    {
      "parameters": {
        "jsCode": "// Detect Google nodes and combine scopes\nconst workflow = $json;\nconst googleNodes = (workflow.nodes || []).filter(n => \n  ['gmail', 'googlesheets', 'googledrive', 'googlecalendar'].some(service => n.type.toLowerCase().includes(service))\n);\n\nconst scopeMap = {\n  gmail: 'https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send',\n  googlesheets: 'https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/drive',\n  googledrive: 'https://www.googleapis.com/auth/drive',\n  googlecalendar: 'https://www.googleapis.com/auth/calendar'\n};\n\nlet scopes = [];\n\ngoogleNodes.forEach(n => {\n  for (const key in scopeMap) {\n    if (n.type.toLowerCase().includes(key)) {\n      scopes.push(scopeMap[key]);\n      break;\n    }\n  }\n});\nscopes = [...new Set(scopes)].join(' ');\n\nreturn [{ json: { workflowName: workflow.name, scopes } }];"
      },
      "id": "ab61b917-201a-4c27-a1ad-4c39ca07ad86",
      "name": "Detect Google Nodes & Scopes1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1184,
        416
      ]
    },
    {
      "parameters": {
        "jsCode": "const workflowName = $node['Detect Google Nodes & Scopes1'].json.workflowName;\nconst scopes = $node['Detect Google Nodes & Scopes1'].json.scopes || '';\nconst access_token = $node['Get Google Access Token'].json.access_token;\n\nconst serviceTypeMap = {\n  gmail: 'gmailOAuth2',\n  googlesheets: 'googleSheetsOAuth2Api',\n  googledrive: 'googleDriveOAuth2Api',\n  googlecalendar: 'googleCalendarOAuth2Api'\n};\n\nlet credentialType = 'googleOAuth2Api';\nconst googleNodes = $json.nodes || [];\ngoogleNodes.forEach(n => {\n  for (const key in serviceTypeMap) {\n    if (n.type.toLowerCase().includes(key)) {\n      credentialType = serviceTypeMap[key];\n      break;\n    }\n  }\n});\n\nconst refreshToken = $json.refreshToken || $json.oauthToken;\n\nreturn [{\n  json: {\n    credentialPayload: {\n      name: `Dynamic Google OAuth2 - ${workflowName}`,\n      type: credentialType,\n      data: {\n        clientId: '353816148637-6cvk28f15u47073vdlphts24qof3rmne.apps.googleusercontent.com',\n        clientSecret: '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',\n        refreshToken: refreshToken,\n        accessToken: access_token,\n        scope: scopes,\n        sendAdditionalBodyProperties: true,\n        additionalBodyProperties: {}\n      }\n    }\n  }\n}];"
      },
