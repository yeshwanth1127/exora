    {
      "parameters": {
        "jsCode": "const workflow = $node['Create Cloned Workflow1'].json;\nconst credential = $node['Create Dynamic Google OAuth Credential1'].json;\n\nconst credentialKeyMap = {\n  'n8n-nodes-base.gmail': 'gmailOAuth2',\n  'n8n-nodes-base.gmailTrigger': 'gmailOAuth2',\n  'n8n-nodes-base.googleSheets': 'googleSheetsOAuth2Api',\n  'n8n-nodes-base.googleDrive': 'googleDriveOAuth2Api',\n  'n8n-nodes-base.googleCalendar': 'googleCalendarOAuth2Api'\n};\n\nconst updatedNodes = (workflow.nodes || []).map(node => {\n  const key = credentialKeyMap[node.type];\n  if (key) {\n    if (!node.credentials) node.credentials = {};\n    node.credentials[key] = { id: credential.id, name: credential.name };\n  }\n  return node;\n});\n\nreturn [{\n  json: {\n    workflowId: workflow.id,\n    updatedWorkflow: {\n      name: workflow.name,\n      nodes: updatedNodes,\n      connections: workflow.connections,\n      settings: workflow.settings\n    },\n    credentialId: credential.id\n  }\n}];"
      },
