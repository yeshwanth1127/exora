    {
      "parameters": {
        "jsCode": "const workflowName = $node['Detect Google Nodes & Scopes1'].json.workflowName;\nconst scopes = $node['Detect Google Nodes & Scopes1'].json.scopes || '';\n\n// Map Google node types to credential types\nconst serviceTypeMap = {\n  gmail: 'gmailOAuth2',\n  googlesheets: 'googleSheetsOAuth2Api',\n  googledrive: 'googleDriveOAuth2Api',\n  googlecalendar: 'googleCalendarOAuth2Api'\n};\n\nlet credentialType = 'googleOAuth2Api';\nconst googleNodes = $json.nodes || [];\ngoogleNodes.forEach(n => {\n  for (const key in serviceTypeMap) {\n    if (n.type.toLowerCase().includes(key)) {\n      credentialType = serviceTypeMap[key];\n      break;\n    }\n  }\n});\n\n// Pull refresh token from webhook input\nconst refreshToken = $json.refreshToken || $json.oauthToken; // fallback if needed\n\nreturn [{\n  json: {\n    credentialPayload: {\n      name: `Dynamic Google OAuth2 - ${workflowName}`,\n      type: credentialType,\n      data: {\n        clientId: '353816148637-6cvk28f15u47073vdlphts24qof3rmne.apps.googleusercontent.com',\n        clientSecret: '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',\n        refreshToken: refreshToken,\n        scope: scopes,\n        sendAdditionalBodyProperties: true,\n        additionalBodyProperties: {}\n      }\n    }\n  }\n}];\n"
      },
      "id": "3b5bba8f-070d-4121-a82a-92014fa6bf2c",
      "name": "Prepare Credential Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        -304
      ]
    },
    {
      "parameters": {
        "jsCode": "const workflow = $node['Create Cloned Workflow1'].json;\nconst credential = $node['Create Dynamic Google OAuth Credential1'].json;\n\nconst credentialKeyMap = {\n  'n8n-nodes-base.gmail': 'gmailOAuth2',\n  'n8n-nodes-base.gmailTrigger': 'gmailOAuth2',\n  'n8n-nodes-base.googleSheets': 'googleSheetsOAuth2Api',\n  'n8n-nodes-base.googleDrive': 'googleDriveOAuth2Api',\n  'n8n-nodes-base.googleCalendar': 'googleCalendarOAuth2Api'\n};\n\nconst updatedNodes = (workflow.nodes || []).map(node => {\n  const key = credentialKeyMap[node.type];\n  if (key) {\n    if (!node.credentials) node.credentials = {};\n    node.credentials[key] = { id: credential.id, name: credential.name };\n  }\n  return node;\n});\n\nreturn [{\n  json: {\n    workflowId: workflow.id,\n    updatedWorkflow: {\n      name: workflow.name,\n      nodes: updatedNodes,\n      connections: workflow.connections,\n      settings: workflow.settings\n    },\n    credentialId: credential.id\n  }\n}];"
      },
