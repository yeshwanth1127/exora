    {
      "parameters": {
        "jsCode": "// Detect Google nodes and combine scopes\nconst workflow = $json;\nconst googleNodes = (workflow.nodes || []).filter(n => \n  ['gmail', 'googlesheets', 'googledrive', 'googlecalendar'].some(service => n.type.toLowerCase().includes(service))\n);\n\nconst scopeMap = {\n  gmail: 'https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send',\n  googlesheets: 'https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/drive',\n  googledrive: 'https://www.googleapis.com/auth/drive',\n  googlecalendar: 'https://www.googleapis.com/auth/calendar'\n};\n\nlet scopes = [];\n\ngoogleNodes.forEach(n => {\n  for (const key in scopeMap) {\n    if (n.type.toLowerCase().includes(key)) {\n      scopes.push(scopeMap[key]);\n      break;  // break to avoid duplicates if multiple keywords match\n    }\n  }\n});\nscopes = [...new Set(scopes)].join(' ');\n\nreturn [{ json: { workflowName: workflow.name, scopes } }];\n"
      },
