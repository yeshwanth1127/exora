# =============================================================================
# Exora main API (exora-mern/server) — copy to .env and fill in values
# =============================================================================
# PostgreSQL (local): create DB first, e.g.
#   sudo -u postgres psql -c 'CREATE DATABASE "exora-web";'
# Optional second DB for CRM-linked activation flows (see crmDb.js):
#   sudo -u postgres psql -c 'CREATE DATABASE "exora-crm";'
# =============================================================================

# --- Server ---
PORT=5555
NODE_ENV=development

# Legacy: server.js only uses this to decide whether to also load ../.env
# The application database is PostgreSQL (below), not MongoDB.
# MONGO_URI=

# --- PostgreSQL (main app: config/db.js) ---
# Prefer a single connection string OR discrete variables (not both required if one is enough).

DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/exora-web

# If you omit DATABASE_URL, these are used (defaults match db.js):
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=exora-web

# For managed Postgres with SSL: set PGSSLMODE=require or true
# PGSSLMODE=

# --- CRM database (config/crmDb.js) — same server, database name exora-crm ---
# Used when activation routes talk to the CRM DB. If DATABASE_URL is set, the code
# rewrites the path to /exora-crm. Without DATABASE_URL, PG* + database exora-crm apply.
# Skip creating exora-crm only if you never hit those activation paths.

# --- Auth & tokens ---
JWT_SECRET=change-me-long-random-string

# 32+ chars recommended; encrypts stored OAuth tokens (OAuthTokens.js)
OAUTH_ENCRYPTION_KEY=change-me-32-byte-secret-key!!

# --- Public site URL (OAuth redirects, HTML responses in activation.js, oauth.js) ---
FRONTEND_URL=http://localhost:5173

# Google OAuth (activation.js, OAuthService.js, ActivationService.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud console (e.g. http://localhost:5555/oauth2/callback or your prod URL)
GOOGLE_REDIRECT_URI=http://localhost:5555/oauth2/callback

# --- n8n (workflows, activation, execution) ---
N8N_BASE_URL=https://your-n8n.example.com
N8N_API_KEY=

# --- Ollama / LLM (BusinessDiscoveryAgent, WorkflowGenerationService, test-ollama.js) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama2

# --- CRM integration (activation.js) — only if CRM API/frontend exist ---
# CRM_API_URL=http://127.0.0.1:8000
# CRM_FRONTEND_URL=http://localhost:3001
