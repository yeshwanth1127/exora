# =============================================================================
# Exora main frontend (Vite) — copy to .env.local for dev or set at build time
# =============================================================================
# Only variables prefixed with VITE_ are exposed to the browser.
# =============================================================================

# API (src/config/api.js, DashboardAlex.jsx)
# Dev: http://localhost:5555/api (matches default API port in this repo)
# Prod (same origin behind nginx): https://your-domain.com/api
VITE_API_BASE_URL=http://localhost:5555/api

# Socket.IO server origin (no /api suffix)
VITE_SOCKET_URL=http://localhost:5555

# Optional: “Open CRM” / CRM card (BusinessDashboard.jsx). Not needed if CRM is not deployed.
# If unset, production builds fall back to https://crm.exora.solutions — set to a placeholder
# or your URL to avoid wrong links.
# VITE_CRM_URL=

# Optional: used only if you add code reading it (not referenced in src today)
# VITE_ENV=development
