# Production: https://exora.solutions/api
# Development: http://localhost:5555/api
VITE_API_BASE_URL=https://exora.solutions/api
VITE_SOCKET_URL=https://exora.solutions

# CRM Frontend URL
# Production: https://crm.exora.solutions
# Development: http://localhost:3001
VITE_CRM_URL=https://crm.exora.solutions

# Environment
VITE_ENV=production

